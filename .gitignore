# Secrets — never commit. Runtime config lives in
# /etc/mediamixer/mediamixer.env on the server, outside this tree.
*.env
.env
.env.*
!.env.example
*.pem
*.key
*-service-account*.json
credentials
.aws/

# Data extracted from the golden source. ExportFromServer2.sh writes here
# by default when run from the repo, and the output is business data, not
# code — it belongs on a disk, not in version control.
migration/*.csv
migration/*.sql
migration/*.dump
migration/verification_*.txt
mediamixer-export-*/

# Virtualenvs — never commit, not even partially
venv/
.venv/
env/
ENV/

# Python
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Media — source clips live in S3, renders live under ugc-assets/exported/.
# Nothing binary belongs in this repository. Test fixtures are generated in
# code, so there is deliberately no exception carved out here: an earlier
# "!tests/fixtures/**" negation re-included everything under that path,
# including __pycache__, which is exactly the trap this comment exists to
# prevent someone re-setting.
*.mov
*.mp4
*.m4v
*.webm
*.mkv
*.avi
*.jpg
*.jpeg
*.png
*.gif
*.heic
*.webp
*.srt

# Local scratch
scratch/
tmp/
*.log

# Archives
*.zip
*.jar
*.tar
*.tar.gz

# OS / editor
.DS_Store
.idea/
.vscode/
*~

# Last, so no earlier negation can re-include compiled bytecode.
__pycache__/
