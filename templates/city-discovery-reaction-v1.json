{
  "template_id": "city-discovery-reaction-v1",
  "version": 1,
  "description": "city-discovery-v1 with the app moved forward and an optional reaction beat after it. The reaction is chosen by the brief's mood and is skipped entirely when no matching performance exists, so this template works whether or not the reaction library covers the mood asked for.",
  "canvas": {
    "width": 1080,
    "height": 1920,
    "fps": 30
  },
  "slots": [
    {
      "role": "hook_visual",
      "asset_types": [
        "broll"
      ],
      "min_ms": 2000,
      "preferred_ms": 2500,
      "max_ms": 3000,
      "required": true,
      "prefer_topic_match": true,
      "prefer_subtypes": [
        "Exterior"
      ],
      "notes": "Opens on place. Exterior preferred."
    },
    {
      "role": "app_demonstration",
      "asset_types": [
        "app"
      ],
      "min_ms": 5000,
      "preferred_ms": 6000,
      "max_ms": 7000,
      "required": true,
      "prefer_topic_match": true,
      "notes": "Moved forward: the product moment lands while attention is still high, rather than three clips in.",
      "match_feature": true
    },
    {
      "role": "reaction_beat",
      "asset_types": [
        "reaction"
      ],
      "min_ms": 2000,
      "preferred_ms": 3000,
      "max_ms": 4000,
      "required": false,
      "prefer_topic_match": false,
      "city_agnostic_ok": true,
      "match_mood": true,
      "notes": "Optional, and the only optional slot in either template. Reactions carry no city, so city_agnostic_ok is set — a city filter would exclude every one of them. match_mood restricts this to the brief's mood, read from merged emotion tags so a performance filed under two emotions is reachable by both. If nothing matches, the slot is skipped and the video is built without it."
    },
    {
      "role": "destination_proof",
      "asset_types": [
        "broll"
      ],
      "min_ms": 4000,
      "preferred_ms": 5000,
      "max_ms": 6000,
      "required": true,
      "prefer_topic_match": true,
      "prefer_subtypes": [
        "Interior"
      ],
      "notes": "Inside the venue — this is real and someone has been there.",
      "cohere_with": "hook_visual"
    },
    {
      "role": "supporting_visual",
      "asset_types": [
        "broll"
      ],
      "min_ms": 3000,
      "preferred_ms": 3500,
      "max_ms": 5000,
      "required": true,
      "prefer_topic_match": true,
      "prefer_subtypes": [
        "Food",
        "Dish"
      ],
      "notes": "The payoff: the dish itself.",
      "cohere_with": "destination_proof"
    }
  ],
  "captions": [
    {
      "role": "hook_visual",
      "pattern": "{place_name}",
      "style": "hook",
      "lead_in_ms": 200
    },
    {
      "role": "supporting_visual",
      "pattern": "{subcategory} in {city}",
      "style": "label",
      "lead_in_ms": 400
    }
  ]
}
