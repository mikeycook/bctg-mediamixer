    {
      "role": "destination_proof",
      "asset_types": ["broll"],
      "min_ms": 4000, "preferred_ms": 5000, "max_ms": 6000,
      "required": true,
      "prefer_topic_match": true,
      "notes": "Establishes the place is real and worth visiting."
    },
    {
      "role": "app_demonstration",
      "asset_types": ["app"],
      "min_ms": 5000, "preferred_ms": 6500, "max_ms": 8000,
      "required": true,
      "prefer_topic_match": false,
      "notes": "The product moment. App recordings only."
