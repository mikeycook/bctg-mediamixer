{
  "template_id": "city-discovery-v1",
  "version": 1,
  "description": "Reaction-free starter. Establish outside, go inside, show the product, pay off on the subject, close.",
  "canvas": {
    "width": 1080,
    "height": 1920,
    "fps": 30
  },
  "slots": [
    {
      "role": "hook_visual",
      "asset_types": [
        "broll"
      ],
      "min_ms": 2000,
      "preferred_ms": 2500,
      "max_ms": 3000,
      "required": true,
      "prefer_topic_match": true,
      "notes": "Establishing shot. Exterior preferred so the video opens on place rather than detail.",
      "prefer_subtypes": [
        "Exterior"
      ]
    },
    {
      "role": "destination_proof",
      "asset_types": [
        "broll"
      ],
      "min_ms": 4000,
      "preferred_ms": 5000,
      "max_ms": 6000,
      "required": true,
      "prefer_topic_match": true,
      "notes": "Inside the venue — the shot that says this is real and someone has been there.",
      "prefer_subtypes": [
        "Interior"
      ],
      "cohere_with": "hook_visual"
    },
    {
      "role": "app_demonstration",
      "asset_types": [
        "app"
      ],
      "min_ms": 5000,
      "preferred_ms": 6500,
      "max_ms": 8000,
      "required": true,
      "prefer_topic_match": true,
      "notes": "The product moment. App subtypes are features (Guide, Map), not framings, so no shot preference.",
      "match_feature": true
    },
    {
      "role": "supporting_visual",
      "asset_types": [
        "broll"
      ],
      "min_ms": 3000,
      "preferred_ms": 4000,
      "max_ms": 5000,
      "required": true,
      "prefer_topic_match": true,
      "notes": "The payoff: the dish itself. Both names listed so this survives renaming subtype Food to Dish.",
      "prefer_subtypes": [
        "Food",
        "Dish"
      ],
      "cohere_with": "destination_proof"
    },
    {
      "role": "cta",
      "asset_types": [
        "app",
        "broll"
      ],
      "min_ms": 2000,
      "preferred_ms": 2500,
      "max_ms": 3000,
      "required": true,
      "prefer_topic_match": false,
      "notes": "Background for generated call-to-action text. No shot preference."
    }
  ],
  "captions": [
    {
      "role": "hook_visual",
      "pattern": "{place_name}",
      "style": "hook",
      "lead_in_ms": 200,
      "notes": "Opens on the name of the place. Dropped entirely if place_name is blank — better no caption than an empty one."
    },
    {
      "role": "destination_proof",
      "pattern": "{subcategory} in {city}",
      "style": "label",
      "lead_in_ms": 400
    },
    {
      "role": "cta",
      "pattern": "Find it in Big City Travel Guide",
      "style": "cta",
      "lead_in_ms": 100,
      "notes": "Fixed copy, no interpolation, so it cannot fail to resolve."
    }
  ]
}
