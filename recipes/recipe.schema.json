{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bctg.local/schemas/recipe-v1.json",
  "title": "MediaMixer render recipe",
  "description": "The contract between selection and rendering. Immutable once written: a revision is a new render with a new id, never an edit.",
  "type": "object",
  "required": ["recipe_version", "template", "brief", "canvas", "timeline", "total_duration_ms", "renderer"],
  "additionalProperties": false,
  "properties": {
    "recipe_version": {"const": 1},
    "template": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1}
      }
    },
    "brief": {"type": "object"},
    "canvas": {
      "type": "object",
      "required": ["width", "height", "fps"],
      "properties": {
        "width": {"type": "integer", "minimum": 2},
        "height": {"type": "integer", "minimum": 2},
        "fps": {"type": "integer", "minimum": 1, "maximum": 120}
      }
    },
    "timeline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["asset_id", "asset_pk", "s3_key", "checksum_sha256", "role",
                     "source_in_ms", "source_out_ms", "timeline_in_ms"],
        "properties": {
          "asset_id": {"type": ["string", "null"]},
          "asset_pk": {"type": "integer"},
          "s3_key": {"type": "string", "minLength": 1},
          "s3_version_id": {"type": ["string", "null"]},
          "checksum_sha256": {
            "type": "string",
            "description": "Every source is pinned by content hash. A render that cannot verify its inputs does not proceed.",
            "pattern": "^[0-9a-f]{64}$"
          },
          "role": {"type": "string", "minLength": 1},
          "source_in_ms": {"type": "integer", "minimum": 0},
          "source_out_ms": {"type": "integer", "minimum": 1},
          "timeline_in_ms": {"type": "integer", "minimum": 0},
          "transform": {"type": "object"},
          "audio_policy": {"type": "object"}
        }
      }
    },
    "total_duration_ms": {"type": "integer", "minimum": 1},
    "captions": {"type": "array"},
    "audio_mix": {"type": "object"},
    "renderer": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"}
      }
    }
  }
}
